# Copy to .env.local and fill in. Never commit .env.local.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string (>= 16 chars) used to hash IPs for anonymous rate limits: `openssl rand -hex 32`
IP_HASH_SALT=

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (Project Settings → Database → Connection string) -------------
# App runtime: Transaction pooler (port 6543). Used by Prisma Client on Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations: Session pooler (port 5432) or direct connection. Used by the Prisma CLI only.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Bookmaker adapters: mock (sample data) | live (real site; needs captured endpoints) ---
SPORTYBET_MODE=mock
BETWAY_MODE=mock

# --- Later milestones (optional until then) --------------------------------
# Match stats: https://dashboard.api-football.com (free plan: 100 requests/day; responses are cached)
API_FOOTBALL_KEY=
# auto = live when API_FOOTBALL_KEY is set, otherwise clearly labelled sample data
STATS_MODE=auto
# M6: https://console.anthropic.com
ANTHROPIC_API_KEY=
# M7: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
