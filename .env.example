# gameclaw environment variables. Copy to .env.local for local dev (`pnpm dev`). Never commit real values.
# Production runs on Cloudflare Workers: public values in wrangler.jsonc "vars", secrets via
# `wrangler secret put` (see docs/deploy.md).
#
# [PUBLIC]  NEXT_PUBLIC_* values are embedded in the browser bundle. Only put safe values here.
# [SERVER]  Server-only. Never prefix these with NEXT_PUBLIC_.
#
# All database access goes through Prisma. There is no Supabase project any more - see
# docs/supabase-retirement.md - so nothing here needs a Supabase URL or key.

# --- App -------------------------------------------------------------------------------
# [PUBLIC] Your site's origin, no trailing slash. Local: http://localhost:3000; prod: https://gameclaw.win (set in wrangler.jsonc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [SERVER] Random secret for hashing client IPs (raw IPs are never stored). Generate: openssl rand -hex 32
IP_HASH_SALT=

# --- Database: Render → gameclaw-db → Connect ---------------------------------------------
# [SERVER] Used by the app at runtime. Render's INTERNAL hostname (the bare `dpg-...`, no dots)
# from inside their network; the external `...frankfurt-postgres.render.com` name otherwise.
# Locally this is whatever Postgres you are developing against.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gameclaw
# [SERVER] Used only by `prisma migrate deploy`. The same database; a separate variable because
# migrations need a session connection rather than a pooled one.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/gameclaw

# --- Bookmaker adapters -----------------------------------------------------------------
# [SERVER] mock = built-in sample slips; live = the real site. Only set live once that bookmaker's
# requests have been captured and verified (docs/capturing-bookmaker-requests.md).
# SportyBet is verified for reading booking codes, fixtures and odds, so it ships live.
# SportyBet, MSport and Football.com are verified for reading codes, booking codes, fixtures and odds.
SPORTYBET_MODE=live
MSPORT_MODE=live
FOOTBALLCOM_MODE=live
BETWAY_MODE=mock

# [SERVER] Whether sample bookmaker data may be served at all. Unset defaults to off in production
# and on everywhere else, which is what you want; set 0 to prove production can't serve samples,
# or 1 locally to exercise the bookmakers that aren't connected yet. (0 | 1)
ALLOW_SAMPLE_DATA=

# --- Match stats: https://dashboard.api-football.com → Account → API key -------------------
# [SERVER] Optional. Free plan = 100 requests/day; responses are cached in Postgres.
API_FOOTBALL_KEY=
# [SERVER] auto = live when API_FOOTBALL_KEY is set, otherwise clearly labelled sample data. (auto | live | sample)
STATS_MODE=auto

# --- AI assistant: https://console.anthropic.com → API Keys -----------------------------
# [SERVER] Required for /chat and match analysis. Set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=
# [SERVER] Optional model overrides. Chat uses the fast model; deep match analysis uses the larger one.
AI_CHAT_MODEL=claude-haiku-4-5
AI_ANALYSIS_MODEL=claude-opus-5-5

# --- Payments: https://dashboard.paystack.com → Settings → API Keys & Webhooks ------------
# [SERVER] Secret key: sk_test_… in test mode, sk_live_… in production. Also verifies webhook signatures.
PAYSTACK_SECRET_KEY=
# [PUBLIC] Public key (pk_test_… / pk_live_…). Optional today; checkout redirects to Paystack's hosted page.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Notifications (optional): npx web-push generate-vapid-keys ------------------------
# [PUBLIC] VAPID public key, used by the browser to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [SERVER] Same public key plus the private key, used to sign pushes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [SERVER] Contact address required by push services.
VAPID_SUBJECT=mailto:hello@gameclaw.win

# --- Ops --------------------------------------------------------------------------------
# [SERVER] Protects /api/v1/cron/cleanup. The Cloudflare Cron Trigger (worker.ts) sends it. Generate: openssl rand -hex 32
CRON_SECRET=
# [BUILD, Workers Builds only] Use the pnpm version pinned in package.json (packageManager).
ENABLE_EXPERIMENTAL_COREPACK=1

# --- Tests only (never set in production) -----------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# MOCK_LATENCY_MS=0
