<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A dark parent even under the OS's light setting: the app is dark-only, and inheriting
         Theme.Light here is what put a white flash in front of every cold launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/gc_canvas</item>
    </style>
</resources>
