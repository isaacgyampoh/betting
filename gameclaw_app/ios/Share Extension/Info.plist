<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Resolved from the CUSTOM_GROUP_ID build setting rather than written here, so the group
	     is named in one place and the extension and the app cannot drift apart. The group has to
	     be registered on the Apple Developer account before it will sign. -->
	<key>AppGroupId</key>
	<string>$(CUSTOM_GROUP_ID)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Text and links only, which is what GameClaw can actually do something with: a
			     booking code pasted from a bookmaker's app, or a share link containing one. The
			     plugin's example also accepts images, movies and files; accepting those here
			     would put GameClaw in the share sheet for every photo on the phone and then have
			     nothing to say about them.

			     This mirrors the Android side exactly, which filters on text/plain alone. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
			</dict>
		</dict>
		<key>NSExtensionMainStoryboard</key>
		<string>MainInterface</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
