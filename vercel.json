{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/v1/cron/cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}
