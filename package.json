{
  "name": "gameclaw",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "next build",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:build:api": "node scripts/cf-build.mjs --config wrangler.api.jsonc",
    "cf:build:ci": "node scripts/migrate-on-deploy.mjs && node scripts/cf-build.mjs",
    "cf:deploy": "MIGRATE=1 node scripts/migrate-on-deploy.mjs && node scripts/cf-build.mjs && CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$DIRECT_URL\" opennextjs-cloudflare deploy",
    "cf:deploy:api": "node scripts/cf-build.mjs --config wrangler.api.jsonc && CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$DIRECT_URL\" opennextjs-cloudflare deploy -- --config wrangler.api.jsonc",
    "cf:preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "db:generate": "node scripts/prisma-generate.mjs node",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-generate.mjs node",
    "start": "next start",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@opennextjs/cloudflare": "1.20.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.63.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "4.145.0"
  }
}
