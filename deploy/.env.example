# Copy to deploy/.env on the VPS and fill in. deploy/.env is gitignored and must never be committed.
#
# Generate every password and salt with:  openssl rand -base64 32
# Generate the backup key pair with:      age-keygen -o backup-key.txt
#   The PUBLIC key goes in BACKUP_AGE_RECIPIENT below. Keep the PRIVATE key off this server -
#   that is what makes the backups independent: a compromised VPS can write them and cannot read them.

# ---------------------------------------------------------------- host / proxy
API_DOMAIN=api.gameclaw.win
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- database
POSTGRES_DB=gameclaw
# Used only by initdb and for recovery. The application never connects as this.
POSTGRES_SUPERUSER=gameclaw_root
POSTGRES_SUPERUSER_PASSWORD=
# Owns the schema; Prisma migrations connect as this.
OWNER_DB_PASSWORD=
# The running application. Rows only, no DDL.
APP_DB_PASSWORD=
# age public key (starts age1...). Backups are encrypted to it.
BACKUP_AGE_RECIPIENT=

# ---------------------------------------------------------------- application
# Must be this service's own public origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://api.gameclaw.win

# Signs GameClaw's own access tokens (lib/identity/session.ts). Rotating this signs everybody out,
# so carry the existing Render value across at cutover rather than generating a new one.
AUTH_JWT_SECRET=

# Hashes client IPs for rate limiting. Carry the Render value across, or existing limiter state and
# any IP-keyed records stop matching.
IP_HASH_SALT=

# Shared with the Cloudflare Worker's scheduled handler. Must match the Worker's CRON_SECRET.
CRON_SECRET=

# Comma-separated, newest first. The audience every Google ID token is checked against; must
# include the client id baked into every APK still in the field.
GOOGLE_WEB_CLIENT_ID=

# The iOS bundle identifier, for Sign in with Apple token verification.
APPLE_BUNDLE_ID=win.gameclaw.app

# ---------------------------------------------------------------- integrations
API_FOOTBALL_KEY=
ANTHROPIC_API_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# The whole Firebase service-account JSON, on one line.
FCM_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- bookmakers
STATS_MODE=auto
SPORTYBET_MODE=live
MSPORT_MODE=live
FOOTBALLCOM_MODE=live
BETWAY_MODE=mock
# Production never serves sample bookmaker data; an unconnected bookmaker refuses instead.
ALLOW_SAMPLE_DATA=0

# ---------------------------------------------------------------- build / ops
GIT_COMMIT=dev
IMAGE_TAG=local
# Optional. If set, monitor.sh posts a line here when a health check fails.
ALERT_WEBHOOK_URL=
