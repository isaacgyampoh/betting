{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameclaw",
  // Custom entry: wraps the OpenNext worker to add the cron handler and the www → apex redirect.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // Only serve on the real domain (no *.workers.dev or preview URLs).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gameclaw.win", "custom_domain": true },
    { "pattern": "www.gameclaw.win", "custom_domain": true }
  ],

  // Run close to the database (Supabase, eu-west-1) since most requests make several queries.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },

  // 03:30 GMT cleanup, 07:00 GMT daily picks: see worker.ts → /api/v1/cron/*.
  "triggers": { "crons": ["30 3 * * *", "0 7 * * *"] },

  // Public / non-secret configuration. Secrets are set with `wrangler secret put` (see docs/deploy.md).
  // scripts/cf-build.mjs also injects the NEXT_PUBLIC_* values below into `next build`.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://gameclaw.win",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qefedcphkmxuxjetmtqw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFlZmVkY3Boa214dXhqZXRtdHF3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3NjE0NTUsImV4cCI6MjEwNjMzNzQ1NX0.0uK_oW-vIBwPfpg1qXi53BjXpF2XjfsdUz2SO9hYh6g",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY": "pk_live_9d21dd9b8bd208a10cd1a1195a0dbd1d477894b1",
    "SPORTYBET_MODE": "mock",
    "BETWAY_MODE": "mock",
    "STATS_MODE": "auto"
  },

  // Pooled Postgres connections next to Supabase (session pooler origin, query caching off).
  // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (see docs/deploy.md).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "673d415bb1174f8092e5649a5675516a" }]

}
