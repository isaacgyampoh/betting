{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameclaw",
  // Custom entry: wraps the OpenNext worker to add the cron handler and the www → apex redirect.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // Only serve on the real domain (no *.workers.dev or preview URLs).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gameclaw.win", "custom_domain": true },
    { "pattern": "www.gameclaw.win", "custom_domain": true }
  ],

  // Smart placement, now for a different reason than when it was added: this Worker makes no
  // database queries at all, but every /api/v1 request it serves is a round trip to the API in
  // Frankfurt, so being placed near that is still worth having.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },

  // 03:30 GMT cleanup, 07:00 GMT daily picks: see worker.ts → /api/v1/cron/*.
  // 03:30 settles yesterday, 07:00 publishes today, 15:00 re-reads the prices.
  //
  // The third one is not housekeeping. refreshSpecialOdds only looks at picks that have not kicked
  // off (`kickoffAt > now`), and with only the first two triggers there was no moment when that
  // could match anything: at 03:30 the day's picks do not exist, and by the next 03:30 they have
  // been played. So prices were never re-read, `lastVerifiedAt` stayed at publication time, and the
  // "price moved" indicator could not fire. 15:00 sits after the 07:00 publish and before the
  // evening kick-offs, which is the window where a price check means something.
  "triggers": { "crons": ["30 3 * * *", "0 7 * * *", "0 15 * * *"] },

  // Public / non-secret configuration. Secrets are set with `wrangler secret put` (see docs/deploy.md).
  // scripts/cf-build.mjs also injects the NEXT_PUBLIC_* values below into `next build`.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://gameclaw.win",

    // The website has no database connection of its own: gameclaw-db permits no external
    // connections. Public, read-only pick data is fetched from the API, which does have one, and
    // worker.ts forwards /api/v1 to the same place. Deliberately absent from render.yaml - set
    // there, the API would call itself. See lib/services/remote-data.ts.
    "GC_DATA_API_BASE": "https://gameclaw-api.onrender.com/api/v1",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY": "pk_live_9d21dd9b8bd208a10cd1a1195a0dbd1d477894b1",
    "SPORTYBET_MODE": "live",
    "MSPORT_MODE": "live",
    "FOOTBALLCOM_MODE": "live",
    "BETWAY_MODE": "mock",
    "STATS_MODE": "auto",
    // Production never serves sample bookmaker data: an unconnected bookmaker refuses instead.
    "ALLOW_SAMPLE_DATA": "0"
  }

  // No database binding, deliberately.
  //
  // There was a Hyperdrive binding here (673d415bb1174f8092e5649a5675516a) pointing at a Supabase
  // project that has been deleted. Every /api/v1 route on gameclaw.win answered 500 or 503 through
  // it while the identical route on Render answered correctly, and both cron jobs failed every
  // morning until worker.ts started calling Render directly.
  //
  // Re-pointing it at gameclaw-db was not an option worth taking: Hyperdrive egresses from
  // Cloudflare's shared address ranges, so letting it in would mean opening the database to ranges
  // used by every Cloudflare customer. worker.ts forwards /api/v1 to the API instead, which already
  // has a private connection, and that leaves exactly one process talking to Postgres.
  //
  // Removing it also means `opennextjs-cloudflare deploy` no longer needs
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE set just to resolve the binding.
}
