# Local secrets for `pnpm cf:preview` (wrangler dev). Copy to .dev.vars. Never commit .dev.vars.
# The website Worker has no database binding and should never query Postgres - worker.ts
# forwards /api/v1 to the API. This is here for `wrangler dev` against a local database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gameclaw
IP_HASH_SALT=
CRON_SECRET=
ANTHROPIC_API_KEY=
PAYSTACK_SECRET_KEY=
API_FOOTBALL_KEY=
